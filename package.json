{
  "name": "@obinexusltd/objc-polycall",
  "version": "1.0.0",
  "description": "Objective-C / Foundation source binding for the Polycall C library (binding ABI v1)",
  "main": "index.js",
  "type": "commonjs",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./include/*": "./include/*",
    "./examples/*": "./examples/*",
    "./tests/*": "./tests/*",
    "./scripts/*": "./scripts/*"
  },
  "files": [
    "index.js",
    "src/",
    "include/",
    "examples/",
    "tests/",
    "scripts/",
    "Makefile",
    "objc-polycallrc",
    "polycall-binding.json",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "src",
    "src": "src",
    "include": "include",
    "example": "examples",
    "test": "tests",
    "scripts": "scripts"
  },
  "scripts": {
    "build": "make",
    "build:objc": "make objc",
    "test": "make test && npm run verify:dry && npm run test:package",
    "test:objc": "make test-objc",
    "test:real": "make test-real",
    "test:memory": "make build/objc_polycall_test && sh tests/valgrind.sh",
    "test:package": "node tests/package.test.js",
    "verify:dry": "make verify-dry",
    "verify": "npm test",
    "prepack": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/objc-polycall.git"
  },
  "keywords": [
    "libpolycall",
    "polycall",
    "objective-c",
    "foundation",
    "cocoa",
    "ffi"
  ],
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/obinexus/objc-polycall/issues"
  },
  "homepage": "https://github.com/obinexus/objc-polycall#readme"
}
